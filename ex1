<!-- MOVIE -->

<h2 id="movie">Movie Ticket Reservation</h2>

<p>Welcome to the Movie registration system. Enjoy your day with us.</p>

<img src="leo.jpg" alt="Movie Poster" width="250" height="300">

<h3>Available Movies</h3>

<ul>
    <li>Leo</li>
    <li>Vikram</li>
    <li>Jailer</li>
</ul>

<form>

<fieldset>

<legend><b>Booking Details</b></legend>

<label>Name:</label>
<input type="text">
<br><br>

<label>Email:</label>
<input type="email">
<br><br>

<label>Phone:</label>
<input type="tel">
<br><br>

<label>Select Movie:</label>

<select>
    <option>Leo</option>
    <option>Vikram</option>
    <option>Jailer</option>
</select>

<br><br>

<label>Number of Tickets:</label>

<select>
    <option>1</option>
    <option>2</option>
    <option>3</option>
    <option>4</option>
</select>

<br><br>

<input type="submit" value="Book Ticket">
<input type="reset" value="Clear">

</fieldset>

</form>

