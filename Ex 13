Style.css

 

{

box-sizing: border-box;

}

body {

margin: 0;

padding: 0;

font-family: Arial, sans-serif;

background: linear-gradient(135deg, #667eea, #764ba2);

min-height: 100vh;

}

.container {

width: 90%;

max-width: 1100px;

margin: 50px auto;

padding: 35px;

background: white;

border-radius: 20px;

box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);

}

h1 {

text-align: center;

color: #333;

margin-bottom: 30px;

}

h2 {

text-align: center;

color: #555;

margin: 25px 0;

}

button {

display: block;

margin: 0 auto 25px;

padding: 13px 30px;

background: #667eea;

color: white;

border: none;

border-radius: 25px;

font-size: 16px;

cursor: pointer;

transition: 0.3s;

}

button:hover {

background: #764ba2;

transform: scale(1.05);

}

table {

width: 100%;

border-collapse: collapse;

overflow: hidden;

border-radius: 12px;

box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);

}

th {

background: #667eea;

color: white;

padding: 15px;

text-align: center;

}

td {

padding: 13px;

text-align: center;

border-bottom: 1px solid #ddd;

color: #333;

}

tr:nth-child(even) {

background-color: #f5f5f5;

}

tr:hover {

background-color: #eee;

}

td:last-child {

font-weight: bold;

}

@media screen and (max-width: 700px) {

.container {

width: 95%;

padding: 20px;

margin: 20px auto;

}

h1 {

font-size: 24px;

}

table {

font-size: 12px;

}

}

}  

th,

td {

padding: 8px 5px;

}

button {

width: 100%; 
}
}
