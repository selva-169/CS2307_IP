<!-- ================= JAVASCRIPT ================= -->

<script>

let cart = [];


/* ================= SHOW PAGE ================= */

function showPage(pageId){

    document.getElementById("home")
    .style.display = "none";

    document.getElementById("register")
    .style.display = "none";

    document.getElementById("login")
    .style.display = "none";

    document.getElementById("mobiles")
    .style.display = "none";

    document.getElementById("fashion")
    .style.display = "none";

    document.getElementById("cart")
    .style.display = "none";


    document.getElementById(pageId)
    .style.display = "block";

    window.scrollTo(0,0);

}


/* ================= REGISTER ================= */

function registerUser(event){

    event.preventDefault();


    let password =
    document.getElementById("password").value;


    let confirmPassword =
    document.getElementById("confirmPassword").value;


    if(password !== confirmPassword){

        alert(
        "Password and Confirm Password do not match!"
        );

        return;

    }


    alert(
    "Registration Successful!"
    );


    showPage("login");

}


/* ================= LOGIN ================= */

function loginUser(event){

    event.preventDefault();


    alert(
    "Login Successful!"
    );


    showPage("home");

}


/* ================= ADD TO CART ================= */

function addToCart(name,price){

    cart.push({

        name:name,

        price:price

    });


    alert(
    name + " added to cart!"
    );


    displayCart();

}


/* ================= DISPLAY CART ================= */

function displayCart(){

    let table =
    document.getElementById("cartTable");


    table.innerHTML =

    `
    <tr>

    <th>
    Product
    </th>

    <th>
    Price
    </th>

    <th>
    Quantity
    </th>

    </tr>
    `;


    let total = 0;


    cart.forEach(function(product){

        let row =
        table.insertRow();


        row.insertCell(0)
        .innerHTML =
        product.name;


        row.insertCell(1)
        .innerHTML =
        "₹" +
        product.price.toLocaleString();


        row.insertCell(2)
        .innerHTML =
        "1";


        total += product.price;

    });


    document
    .getElementById("total")
    .innerHTML =
    "Total Amount: ₹" +
    total.toLocaleString();

}


/* ================= CHECKOUT ================= */

function checkout(){

    if(cart.length === 0){

        alert(
        "Your cart is empty!"
        );

        return;

    }


    alert(
    "Thank you for shopping!\n" +
    "Your order has been placed successfully."
    );

}


/* ================= INITIAL CART ================= */

displayCart();

</script>


