package com.ticket; 

import java.io.IOException; 

import java.io.PrintWriter; 

import java.sql.Connection; 

import java.sql.DriverManager; 

import java.sql.PreparedStatement; 

import java.sql.ResultSet; 

import java.sql.SQLException; 

import javax.servlet.ServletException; 

import javax.servlet.annotation.WebServlet; 

import javax.servlet.http.HttpServlet; 

import javax.servlet.http.HttpServletRequest; 

import javax.servlet.http.HttpServletResponse; 

@WebServlet("/MovieServlet") 

public class MovieServlet extends HttpServlet { 

@Override 

protected void doPost(HttpServletRequest request,HttpServletResponse response)throws ServletException,IOException { 

response.setContentType("text/html"); 

PrintWriter out=response.getWriter(); 

String userName=request.getParameter("userName"); 

String mobile=request.getParameter("mobile"); 

String movieName=request.getParameter("movieName"); 

String timing=request.getParameter("timing"); 

int numTickets=Integer.parseInt(request.getParameter("numTickets")); 

String seatType=request.getParameter("seatType"); 

String[] snackArray=request.getParameterValues("snacks"); 

String snacks=""; 

if(snackArray!=null){ 

for(String snack:snackArray){ 

snacks=snacks+snack+", "; 

} 

}else{ 

snacks="No Snacks"; 

} 

String additionalRequest=request.getParameter("additionalRequest"); 

Connection con=null; 

try{ 

Class.forName("com.mysql.cj.jdbc.Driver"); 

con=DriverManager.getConnection("jdbc:mysql://localhost:3306/servlet"+"?useSSL=false"+"&allowPublicKeyRetrieval=true"+"&serverTimezone=UTC","root","mysql"); 

String insertSQL="INSERT INTO movie_bookings "+"(user_name,mobile,movie_name,timing,"+"num_tickets,seat_type,snacks,"+"additional_request) "+"VALUES(?,?,?,?,?,?,?,?)"; 

PreparedStatement insert=con.prepareStatement(insertSQL); 

insert.setString(1,userName); 

insert.setString(2,mobile); 

insert.setString(3,movieName); 

insert.setString(4,timing); 

insert.setInt(5,numTickets); 

insert.setString(6,seatType); 

insert.setString(7,snacks); 

insert.setString(8,additionalRequest); 

insert.executeUpdate(); 

String selectSQL="SELECT * FROM movie_bookings "+"ORDER BY booking_id DESC"; 

PreparedStatement select=con.prepareStatement(selectSQL); 

ResultSet rs=select.executeQuery(); 

out.println("<html>"); 

out.println("<head>"); 

out.println("<title>Movie Booking Details</title>"); 

out.println("<style>"); 

out.println("body {"+"font-family: Arial;"+"background-color: lightyellow;"+"text-align:center;"+"}"); 

out.println("table {"+"margin:auto;"+"border-collapse:collapse;"+"background-color:white;"+"}"); 

out.println("th,td {"+"border:1px solid black;"+"padding:10px;"+"}"); 

out.println("th {"+"background-color:lightblue;"+"}"); 

out.println("h2 {"+"color:green;"+"}"); 

out.println("</style>"); 

out.println("</head>"); 

out.println("<body>"); 

out.println("<h2>Movie Booking Successful!</h2>"); 

out.println("<h3>Saved Booking Details</h3>"); 

out.println("<table>"); 

out.println("<tr>"); 

out.println("<th>Booking ID</th>"); 

out.println("<th>Name</th>"); 

out.println("<th>Mobile</th>"); 

out.println("<th>Movie</th>"); 

out.println("<th>Timing</th>"); 

out.println("<th>Tickets</th>"); 

out.println("<th>Seat Type</th>"); 

out.println("<th>Snacks</th>"); 

out.println("<th>Request</th>"); 

out.println("<th>Booking Date</th>"); 

out.println("</tr>"); 

while(rs.next()){ 

out.println("<tr>"); 

out.println("<td>"+rs.getInt("booking_id")+"</td>"); 

out.println("<td>"+rs.getString("user_name")+"</td>"); 

out.println("<td>"+rs.getString("mobile")+"</td>"); 

out.println("<td>"+rs.getString("movie_name")+"</td>"); 

out.println("<td>"+rs.getString("timing")+"</td>"); 

out.println("<td>"+rs.getInt("num_tickets")+"</td>"); 

out.println("<td>"+rs.getString("seat_type")+"</td>"); 

out.println("<td>"+rs.getString("snacks")+"</td>"); 

out.println("<td>"+rs.getString("additional_request")+"</td>"); 

out.println("<td>"+rs.getTimestamp("booking_date")+"</td>"); 

out.println("</tr>"); 

} 

out.println("</table>"); 

out.println("<br><br>"); 

out.println("<a href='movie.html'>"+"Book Another Movie"+"</a>"); 

out.println("&nbsp;&nbsp;"); 

out.println("<a href='index.html'>"+"Home"+"</a>"); 

out.println("</body>"); 

out.println("</html>"); 

rs.close(); 

select.close(); 

insert.close(); 

} 

catch(ClassNotFoundException e){ 

out.println("<h3>JDBC Driver Not Found</h3>"); 

out.println(e.getMessage()); 

} 

catch(SQLException e){ 

out.println("<h3>Database Error</h3>"); 

out.println(e.getMessage()); 

} 

finally{ 

try{ 

if(con!=null){ 

con.close(); 

} 

}catch(SQLException e){ 

e.printStackTrace(); 

} 

out.close(); 

} 

} 

} 

 

 

 

 

 

 

 

 

 

 

 

 
