package com.shopping.util;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.util.logging.Level;
import java.util.logging.Logger;
/**
Enterprise utility coordinator handling persistence layer pipeline connection initializations.
Configured specifically for isolated personal database profiles.
/
public class DBConnection {
private static final Logger LOGGER = Logger.getLogger(DBConnection.class.getName());
// Consolidated driver connectivity parameters
private static final String DRIVER_CLASS_NAME = "com.mysql.cj.jdbc.Driver";
// TARGET CHANGED TO: my_shopping_db to keep your own data separate
private static final String URL = "jdbc:mysql://localhost:3306/my_shopping_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true";
private static final String USER = "root";
private static final String PASSWORD = "mysql";
// Static initialization block handles driver loading automatically on class deployment
static {
try {
Class.forName(DRIVER_CLASS_NAME);
LOGGER.info("MySQL JDBC Connector Driver successfully loaded into personal runtime context.");
} catch (ClassNotFoundException e) {
LOGGER.log(Level.SEVERE, "Critical Infrastructure Alert: MySQL JDBC Driver variant missing from application build dependencies.", e);
throw new ExceptionInInitializerError("System initialization halted: Missing required Database Connector library. Details: " + e.getMessage());
}
}
/**
Private constructor prevents explicit class initialization instantiation.
/
private DBConnection() {
throw new UnsupportedOperationException("Utility connection architecture cannot be explicitly instantiated.");
}
/**
Spawns a fresh active database session link directly into the relational management storage server.
Ensure you leverage a try-with-resources statement on execution block endpoints to prevent socket leak traces.

@return Active database connection link session
@throws SQLException If database access error occurs or timeout conditions trigger
/
public static Connection getConnection() throws SQLException {
try {
return DriverManager.getConnection(URL, USER, PASSWORD);
} catch (SQLException e) {
LOGGER.log(Level.SEVERE, "Database Connection Pipeline Request Failed. Destination Target: " + URL, e);
throw e;
}
}
}
