package com.shopping.model;
import java.math.BigDecimal;
import java.sql.Date;
public class Order {
private int orderId;
private String customerName;
private String productName;
private int quantity;
private BigDecimal price;
private BigDecimal totalAmount;
private Date orderDate;
private String address;
/**
Default constructor required for framework serialization and reflection operations.
/
public Order() {
// Explicitly declared empty body
}
/**
Data creation constructor used to assemble new records before database allocation.
/
public Order(String customerName, String productName, int quantity,
BigDecimal price, BigDecimal totalAmount, Date orderDate, String address) {
this.customerName = customerName;
this.productName = productName;
this.quantity = quantity;
this.price = price;
this.totalAmount = totalAmount;
this.orderDate = orderDate;
this.address = address;
}
/**
Database mapping constructor used when extracting historical data containing primary keys.
/
public Order(int orderId, String customerName, String productName, int quantity,
BigDecimal price, BigDecimal totalAmount, Date orderDate, String address) {
this.orderId = orderId;
this.customerName = customerName;
this.productName = productName;
this.quantity = quantity;
this.price = price;
this.totalAmount = totalAmount;
this.orderDate = orderDate;
this.address = address;
}
// ---- Clean Getters and Setters ----
public int getOrderId() {
return orderId;
}
public void setOrderId(int orderId) {
this.orderId = orderId;
}
public String getCustomerName() {
return customerName;
}
public void setCustomerName(String customerName) {
this.customerName = customerName;
}
public String getProductName() {
return productName;
}
public void setProductName(String productName) {
this.productName = productName;
}
public int getQuantity() {
return quantity;
}
