package com.shopping.controller;
import com.shopping.dao.OrderDAO;
import com.shopping.model.Order;
import java.io.IOException;
import java.math.BigDecimal;
import java.sql.Date;
import java.util.Objects;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
@WebServlet(name = "AddOrderServlet", urlPatterns = {"/AddOrderServlet"})
public class AddOrderServlet extends HttpServlet {
private final OrderDAO orderDAO = new OrderDAO();
@Override
protected void doPost(HttpServletRequest request, HttpServletResponse response)
throws ServletException, IOException {
try {
// 1. Extract inputs safely and trim trailing white spaces
String customerName = Objects.toString(request.getParameter("customerName"), "").trim();
String productName = Objects.toString(request.getParameter("productName"), "").trim();
String qtyParam = request.getParameter("quantity");
String priceParam = request.getParameter("price");
String dateParam = request.getParameter("orderDate");
String address = Objects.toString(request.getParameter("address"), "").trim();
// 2. Validate essential inputs against null or blank values
if (customerName.isEmpty() || productName.isEmpty() || qtyParam == null || priceParam == null || dateParam == null) {
handleFailure(request, response, "All fields marked with an asterisk are required.");
return;
}
// 3. Parse data values inside a controlled block to capture formatting issues
int quantity = Integer.parseInt(qtyParam);
if (quantity <= 0) {
handleFailure(request, response, "Quantity must be a positive number greater than zero.");
return;
}
BigDecimal price = new BigDecimal(priceParam);
if (price.compareTo(BigDecimal.ZERO) < 0) {
handleFailure(request, response, "Price cannot be a negative value.");
return;
}
// Calculate total financial values safely
BigDecimal totalAmount = price.multiply(BigDecimal.valueOf(quantity));
Date orderDate = Date.valueOf(dateParam);
// 4. Assemble the business entity model object
Order order = new Order(customerName, productName, quantity, price, totalAmount, orderDate, address);
// 5. Commit record to database using persistent DAO layer
boolean isSaved = orderDAO.addOrder(order);
if (isSaved) {
response.sendRedirect(request.getContextPath() + "/viewOrders.jsp");
} else {
handleFailure(request, response, "Database transaction failed. Please check server logs.");
}
} catch (IllegalArgumentException ex) {
// GlassFish Fix: This catches BOTH NumberFormatException and IllegalArgumentException safely
handleFailure(request, response, "Invalid numerical data or date structure entered.");
} catch (Exception ex) {
// Catch-all block for unhandled infrastructure layer issues
handleFailure(request, response, "An unexpected application error occurred: " + ex.getMessage());
}
}
private void handleFailure(HttpServletRequest request, HttpServletResponse response, String feedbackMessage)
throws ServletException, IOException {
request.setAttribute("errorMessage", feedbackMessage);
request.getRequestDispatcher("orderForm.jsp").forward(request, response);
}
}
